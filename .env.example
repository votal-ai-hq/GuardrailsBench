# Copy to .env and fill in. .env is gitignored; never commit real credentials.
#
# Only the http-api system reads anything here, and only via ${VAR} expansion in
# its JSON config's headers (see configs/http_api.example.json). An unset
# variable is a loud error rather than an empty header, because an empty
# Authorization header reads as an auth failure and wastes an afternoon.

# Bearer token for the guardrail endpoint under test.
GUARDRAIL_API_KEY=

# Everything else in this repo runs offline: build, validate, leaderboard and
# the whole test suite need no network and no credentials.
